<?xml version="1.0" encoding="utf-8"?>
<extension version="4.0" type="component" method="upgrade">
	<name>COM_SWJPROJECTS</name>
	<author>Sergey Tolkachyov</author>
	<creationDate>25.07.2026</creationDate>
	<copyright>Copyright (c) 2018 - 2026 Sergey Tolkachyov. All rights reserved.</copyright>
	<license>https://www.gnu.org/copyleft/gpl.html GNU/GPL</license>
	<authorEmail>info@web-tolk.ru</authorEmail>
	<authorUrl>https://web-tolk.ru</authorUrl>
	<version>2.7.1</version>
	<description>COM_SWJPROJECTS_DESCRIPTION</description>
	<namespace path="src">Joomla\Component\SWJProjects</namespace>
	<scriptfile>script.php</scriptfile>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="site">
		<language tag="en-GB">language/en-GB/com_swjprojects.ini</language>
		<language tag="en-GB">language/en-GB/com_swjprojects.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/com_swjprojects.ini</language>
		<language tag="ru-RU">language/ru-RU/com_swjprojects.sys.ini</language>
	</languages>
	<administration>
		<menu>
			<params>
				<dashboard>swjprojects</dashboard>
			</params>
			COM_SWJPROJECTS
		</menu>
		<files folder="admin">
			<folder>forms</folder>
			<folder>presets</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<filename>access.xml</filename>
			<filename>config.xml</filename>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB/com_swjprojects.ini</language>
			<language tag="en-GB">language/en-GB/com_swjprojects.sys.ini</language>
			<language tag="ru-RU">language/ru-RU/com_swjprojects.ini</language>
			<language tag="ru-RU">language/ru-RU/com_swjprojects.sys.ini</language>
		</languages>
	</administration>
	<media destination="com_swjprojects" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<folder>images</folder>
	</media>
	<layouts destination="components/swjprojects" folder="layouts">
		<folder>changelog</folder>
		<folder>field</folder>
		<folder>project</folder>
		<folder>toolbar</folder>
		<folder>translate</folder>
	</layouts>
	<dashboards>
		<dashboard title="COM_SWJPROJECTS" icon="icon-folder-open">swjprojects</dashboard>
	</dashboards>
</extension>
